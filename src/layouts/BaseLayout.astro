---
import '../styles/tokens.css';
import '../styles/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Overrides the default OG image. */
  ogImage?: string;
  /** `article` for guides and news, `website` elsewhere. */
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  updatedAt?: Date;
  /** JSON-LD injected as-is. Built server-side; never from user input. */
  structuredData?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  ogType = 'website',
  publishedAt,
  updatedAt,
  structuredData,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImageUrl = new URL(ogImage, SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} — ${SITE.name}`;
---

<!doctype html>
<html lang={SITE.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#090b0c" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} — Rehberler`}
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap&subset=latin,latin-ext"
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      /*
       * `is:inline` tells Astro to emit this tag verbatim rather than treating
       * it as a script to process and bundle. Without it Astro reports a hint,
       * and a future version could try to transform a JSON-LD payload as if it
       * were JavaScript. The content is built server-side from typed data and
       * never contains visitor input.
       */
      structuredData && (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }
  </head>

  <body>
    <a href="#main" class="skip">İçeriğe geç</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Private analytics beacon. Deduplicated per page per session; every
         path is wrapped so it can never throw on a visitor's page. -->
    <script src="/analytics.js" defer is:inline></script>
  </body>
</html>
