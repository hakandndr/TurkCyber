---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Share from '../components/Share.astro';
import Comments from '../components/Comments.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { SITE, getCategory, DIFFICULTY_LABELS } from '../config/site';
import {
  CONTENT_KINDS,
  articleLd,
  breadcrumbLd,
  kindOfCollection,
  ldGraph,
  metaDescription,
} from '../lib/seo';
import {
  articlePath,
  formatTurkishDate,
  type Article,
  type Guide,
  type Verdict,
} from '../lib/content';

interface Props {
  entry: Article;
  related: Guide[];
}

const { entry, related } = Astro.props;
const { data } = entry;
const category = getCategory(data.category);
const url = new URL(articlePath(entry), SITE.url).href;

// Four collections render through this layout and they differ in real ways:
// only guides carry difficulty, only news carries a source, only myths carry a
// verdict, only technical entries carry a prerequisite. Branch on the
// collection explicitly rather than treating "not a guide" as "news" — that
// assumption broke once already, when myths landed.
const isNews = entry.collection === 'news';
const isMyth = entry.collection === 'myths';
const isTechnical = entry.collection === 'technical';

const kind = kindOfCollection(entry.collection);
const section = { href: CONTENT_KINDS[kind].basePath, label: CONTENT_KINDS[kind].section };

// Narrow on `entry`, not on a boolean: a boolean flag cannot narrow the union
// that `entry.data` resolves to, so the fields below would need casts and a
// cast would hide a genuine mistake if a schema changed.
const myth = entry.collection === 'myths' ? entry.data : null;
const news = entry.collection === 'news' ? entry.data : null;
const guide = entry.collection === 'guides' ? entry.data : null;
const technical = entry.collection === 'technical' ? entry.data : null;

const path = articlePath(entry);
const description = metaDescription(data.description, data.seoDescription);

const base = articleLd({
  headline: data.title,
  description,
  path,
  publishedAt: data.publishedAt,
  updatedAt: data.updatedAt,
  author: data.author,
  section: category?.name,
  tags: data.tags,
});

/*
 * A myth page really is a claim review, and it has the data to say so
 * honestly: the title IS the claim, and the verdict IS the rating. The
 * three-point scale below is the site's own `VERDICTS`, not an invented
 * confidence score — `kismen` sits in the middle because most security myths
 * are true in a narrow case and wrong as a general rule.
 */
const MYTH_RATING = { efsane: 1, kismen: 2, gercek: 3 } as const;

const articleNode: Record<string, unknown> = myth
  ? {
      '@type': 'ClaimReview',
      url: new URL(path, SITE.url).href,
      claimReviewed: data.title,
      datePublished: data.publishedAt.toISOString(),
      author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: MYTH_RATING[myth.verdict],
        bestRating: 3,
        worstRating: 1,
        alternateName: myth.verdictLine,
      },
    }
  : { ...base, '@type': isNews ? 'NewsArticle' : isTechnical ? 'TechArticle' : 'Article' };

// The trail here must match the visible breadcrumb below it, element for
// element. Structured data that disagrees with the page is a markup
// violation, not a shortcut.
const crumbs = [
  { name: 'Ana sayfa', path: '/' },
  { name: section.label, path: section.href },
  ...(category ? [{ name: category.name, path: `/konular/${category.id}/` }] : []),
  { name: data.title, path },
];

const structuredData = ldGraph(articleNode, breadcrumbLd(crumbs));
---

<BaseLayout
  title={data.title}
  seoTitle={data.seoTitle}
  kind={kind}
  description={description}
  ogType="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  structuredData={structuredData}
  noindex={data.status !== 'published'}
>
  <article class:list={['container-reading', 'article', isTechnical && 'article-technical']}>
    <nav aria-label="Konum" class="breadcrumb">
      <a href="/">Ana sayfa</a>
      <span aria-hidden="true">/</span>
      <a href={section.href}>{section.label}</a>
      {
        category && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/konular/${category.id}/`}>{category.name}</a>
          </>
        )
      }
    </nav>

    <header class="article-head">
      {
        isTechnical && (
          <p class="technical-classification">
            <span>Mühendislik notu</span>
            <span>{category?.name ?? section.label}</span>
          </p>
        )
      }
      {
        myth && (
          <div class="verdict-row">
            <VerdictBadge verdict={myth.verdict as Verdict} size="large" />
            <p class="verdict-line">{myth.verdictLine}</p>
          </div>
        )
      }

      <h1 class:list={[isMyth && 'claim']}>
        {isMyth ? <>&ldquo;{data.title}&rdquo;</> : data.title}
      </h1>
      <p class="article-lede">{data.description}</p>

      {
        technical ? (
          <dl class="technical-meta">
            <div>
              <dt>Kategori</dt>
              <dd>{category?.name ?? section.label}</dd>
            </div>
            <div>
              <dt>Yayın</dt>
              <dd>
                <time datetime={data.publishedAt.toISOString()}>
                  {formatTurkishDate(data.publishedAt)}
                </time>
              </dd>
            </div>
            {data.updatedAt && (
              <div class="is-updated">
                <dt>Güncelleme</dt>
                <dd>
                  <time datetime={data.updatedAt.toISOString()}>
                    {formatTurkishDate(data.updatedAt)}
                  </time>
                </dd>
              </div>
            )}
            <div>
              <dt>Okuma</dt>
              <dd>{technical.readingTime} dakika</dd>
            </div>
            <div>
              <dt>Derinlik</dt>
              <dd>İLERİ SEVİYE</dd>
            </div>
            {data.status !== 'published' && (
              <div>
                <dt>Durum</dt>
                <dd class="draft-badge">{data.status}</dd>
              </div>
            )}
          </dl>
        ) : (
          <div class="article-meta">
            <time datetime={data.publishedAt.toISOString()}>
              {formatTurkishDate(data.publishedAt)}
            </time>
            {data.updatedAt && (
              <span class="updated">Güncellendi: {formatTurkishDate(data.updatedAt)}</span>
            )}
            {guide && <span>{guide.readingTime} dk okuma</span>}
            {guide && <span>{DIFFICULTY_LABELS[guide.difficulty]}</span>}
            {data.status !== 'published' && <span class="draft-badge">{data.status}</span>}
          </div>
        )
      }
    </header>

    {
      technical?.prerequisite && (
        <aside class="prerequisite">
          <p class="eyebrow">Bunu okumadan önce</p>
          <p>{technical.prerequisite}</p>
        </aside>
      )
    }

    {
      data.summary && (
        <aside class="summary">
          <p class="eyebrow">Kısaca</p>
          <p>{data.summary}</p>
        </aside>
      )
    }

    {
      data.uiVerifiedAt && (
        <p class="ui-verified">
          Bu rehberdeki adımlar {formatTurkishDate(data.uiVerifiedAt)} tarihinde kontrol edildi.
          Uygulama arayüzleri değişebilir; bir adım eşleşmiyorsa yorumlarda bildirin.
        </p>
      )
    }

    {
      isTechnical && (
        <p class="body-boundary" aria-hidden="true">
          Analiz gövdesi / başlangıç
        </p>
      )
    }
    <div class="prose">
      <slot />
    </div>

    {
      news && (
        <p class="source-line">
          Kaynak:{' '}
          <a href={news.sourceUrl} rel="noopener nofollow" target="_blank">
            {news.sourceName}
          </a>
        </p>
      )
    }

    <Share title={data.title} url={url} />

    {
      related.length > 0 && (
        <section class="related">
          <h2>İlgili rehberler</h2>
          <div class="related-grid">
            {related.map((item) => (
              <ArticleCard entry={item} headingLevel={3} />
            ))}
          </div>
        </section>
      )
    }

    <Comments slug={entry.id} />
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--sp-6) var(--sp-8);
    background: var(--surface-0);
  }

  .breadcrumb {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-bottom: var(--sp-5);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--brand-accent-strong);
  }

  .article-head h1 {
    margin-bottom: var(--sp-4);
  }

  .technical-classification {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
    padding: var(--sp-2) 0 var(--sp-2) var(--sp-4);
    border-left: var(--trace-thickness) solid var(--interaction-accent);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.11em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  /* A myth's headline is a quoted claim, so it is set apart from the
     assertive voice the rest of the site uses for its own headings. */
  .article-head h1.claim {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    color: var(--text-muted);
    font-size: var(--step-3);
  }

  .verdict-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .verdict-line {
    flex: 1 1 20rem;
    color: var(--text);
    font-size: var(--step-1);
  }

  .article-lede {
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 56ch;
  }

  .article-meta {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-4);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .article-meta .updated {
    color: var(--green);
  }

  .technical-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(9rem, 100%), 1fr));
    gap: 0;
    margin-top: var(--sp-5);
    padding-block: var(--sp-3);
    border-block: 1px solid var(--border);
  }

  .technical-meta > div {
    min-width: 0;
    padding: var(--sp-1) var(--sp-4);
    border-left: 1px solid var(--border);
  }

  .technical-meta > div:first-child {
    border-left-color: var(--frame-node);
  }

  .technical-meta dt,
  .technical-meta dd {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.55;
  }

  .technical-meta dt {
    color: var(--text-faint);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .technical-meta dd {
    margin: 0;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .technical-meta .is-updated dd {
    color: var(--green);
  }

  /*
   * The technical lane is labelled on the page, not just in navigation. A
   * reader who arrived from search should be able to tell in one glance that
   * this explains a mechanism rather than giving them steps to follow.
   */
  .level-badge {
    color: var(--brand-accent-strong);
    letter-spacing: 0.12em;
  }

  .prerequisite {
    margin-top: var(--sp-5);
    max-width: var(--measure);
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--text-faint);
    border-radius: var(--radius);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  .prerequisite p:last-child {
    margin-top: var(--sp-2);
  }

  .draft-badge {
    color: var(--amber);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .summary {
    margin-top: var(--sp-5);
    max-width: var(--measure);
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand-accent-strong);
    border-radius: var(--radius);
  }

  .summary p:last-child {
    margin-top: var(--sp-2);
  }

  .body-boundary {
    position: relative;
    margin-top: var(--sp-7);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border-strong);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
    text-transform: uppercase;
  }

  .body-boundary::before {
    content: '';
    position: absolute;
    top: -2px;
    left: 0;
    width: var(--trace-node-size);
    height: var(--trace-node-size);
    background: var(--interaction-accent);
  }

  .ui-verified {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* --- article body --- */

  .prose {
    margin-top: var(--sp-6);
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.75;
  }

  .article-technical .body-boundary + .prose {
    margin-top: var(--sp-4);
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--sp-7);
    margin-bottom: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
  }

  /* Stronger hierarchy is scoped to long, structural technical entries. */
  .article-technical .prose :global(h2) {
    margin-top: var(--sp-8);
    margin-bottom: var(--sp-4);
    padding-top: var(--sp-4);
    border-top-color: var(--border-strong);
    letter-spacing: -0.015em;
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--sp-5);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--sp-5);
  }

  .prose :global(li) {
    margin-bottom: var(--sp-2);
  }

  .prose :global(ol) {
    counter-reset: step;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--border-strong);
    padding-left: var(--sp-4);
    color: var(--text-muted);
    margin-bottom: var(--sp-4);
  }

  .prose :global(img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-block: var(--sp-5);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-bottom: var(--sp-5);
    background: var(--surface-0);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--sp-3);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: var(--surface-2);
  }

  /*
   * Reusable technical vocabulary: an architecture pipeline, explicit attack
   * paths, wide comparison blocks and locally scrolling code samples.
   */
  .prose :global(.arch) {
    list-style: none;
    padding: 0;
    margin: var(--sp-6) 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .prose :global(.node) {
    position: relative;
    margin: 0;
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  /* The connector. A drawn line between stages, not a gap between cards. */
  .prose :global(.node + .node) {
    margin-top: var(--sp-5);
  }

  .prose :global(.node + .node::before) {
    content: '';
    position: absolute;
    left: var(--sp-6);
    top: calc(var(--sp-5) * -1);
    height: var(--sp-5);
    border-left: 1px solid var(--border-strong);
  }

  .prose :global(.node-name) {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    flex-wrap: wrap;
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(.node-tag) {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    padding: 0.15em 0.45em;
  }

  /* in / checks / out, on one line where there is room. */
  .prose :global(.node-io) {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-4);
    margin-top: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: var(--trace-thickness) solid
      color-mix(in srgb, var(--brand-accent) 45%, transparent);
  }

  .prose :global(.node-io > div) {
    position: relative;
    min-width: 0;
  }

  .prose :global(.node-io > div::before) {
    content: '';
    position: absolute;
    top: calc(-1 * var(--sp-4) - 2px);
    left: 0;
    width: var(--trace-node-size);
    height: var(--trace-node-size);
    background: var(--brand-accent-strong);
  }

  .prose :global(.node-io > div:nth-child(2)::before) {
    background: var(--border-strong);
  }

  .prose :global(.io-label) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brand-accent-strong);
    margin-bottom: var(--sp-2);
  }

  .prose :global(.node-io > div:nth-child(2) .io-label) {
    color: var(--text-muted);
  }

  .prose :global(.io-value) {
    display: block;
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  /*
   * The boundary line is the point of the whole block: the assumption this
   * stage rests on. It gets its own rule so it never reads as a fourth column
   * of the same kind of information.
   */
  .prose :global(.node-boundary) {
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px dashed var(--border-strong);
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .prose :global(.node-boundary b) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(.attack-path) {
    list-style: none;
    padding: 0;
    margin: var(--sp-6) 0;
  }

  .prose :global(.ap-step) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-2);
    padding: var(--sp-4) 0 var(--sp-4) var(--sp-5);
    border-top: 1px solid var(--border);
    position: relative;
  }

  /* Red marks the departure from the pipeline. It is the only accent here. */
  .prose :global(.ap-step::before) {
    content: '';
    position: absolute;
    left: 0;
    top: calc(var(--sp-4) + 0.55em);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--red);
  }

  .prose :global(.ap-name) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
  }

  .prose :global(.ap-stage) {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--red);
  }

  .prose :global(.ap-why) {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.65;
  }

  /*
   * Wide blocks — architecture and comparison tables — are allowed past the
   * reading measure on a large screen. Constraining a five-column table to
   * 68ch produces a table nobody can read.
   *
   * On a narrow screen the block scrolls INSIDE itself. Verified at 320px:
   * without this the table painted outside the viewport and the last column
   * was unreachable. Horizontal overflow therefore stays local to the block.
   */
  .prose :global(.wide) {
    max-width: none;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    background: var(--surface-0);
  }

  .prose :global(.wide table) {
    min-width: 34rem;
    margin-bottom: 0;
  }

  @media (min-width: 72rem) {
    .prose :global(.wide) {
      width: calc(100% + 12rem);
      margin-inline: -6rem;
      padding-inline: 6rem;
    }
  }

  /*
   * Code samples. `pre` has no intrinsic width limit, so a long
   * `Set-Cookie` line pushed itself clean out of the reading column — the
   * text was there and unreachable. It scrolls in its own box instead.
   */
  .prose :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-1);
    margin-bottom: var(--sp-5);
    /* Comfortable rather than tiny: this is documentation, not a terminal. */
    font-size: 0.86rem;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    display: block;
    min-width: 0;
    white-space: pre;
  }

  @media (max-width: 44rem) {
    .prose :global(.node-io) {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-3);
    }
    .prose :global(.node + .node::before) {
      left: var(--sp-5);
    }
  }

  .source-line {
    margin-top: var(--sp-5);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .related {
    margin-top: var(--sp-7);
  }

  .related h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
