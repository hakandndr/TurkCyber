---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Share from '../components/Share.astro';
import Comments from '../components/Comments.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import { SITE, getCategory, DIFFICULTY_LABELS } from '../config/site';
import {
  articlePath,
  formatTurkishDate,
  type Article,
  type Guide,
  type Verdict,
} from '../lib/content';

interface Props {
  entry: Article;
  related: Guide[];
}

const { entry, related } = Astro.props;
const { data } = entry;
const category = getCategory(data.category);
const url = new URL(articlePath(entry), SITE.url).href;

// Three collections render through this layout and they differ in real ways:
// only guides carry difficulty and reading time, only news carries a source,
// only myths carry a verdict. Branch on the collection explicitly rather than
// treating "not a guide" as "news" — that assumption broke when myths landed.
const isNews = entry.collection === 'news';
const isMyth = entry.collection === 'myths';

const SECTION = {
  guides: { href: '/rehberler/', label: 'Rehberler' },
  news: { href: '/haberler/', label: 'Haberler' },
  myths: { href: '/efsane-mi-gercek-mi/', label: 'Efsane mi, gerçek mi?' },
} as const;

const section = SECTION[entry.collection as keyof typeof SECTION] ?? SECTION.guides;

// Narrow on `entry`, not on a boolean: a boolean flag cannot narrow the union
// that `entry.data` resolves to, so the fields below would need casts and a
// cast would hide a genuine mistake if a schema changed.
const myth = entry.collection === 'myths' ? entry.data : null;
const news = entry.collection === 'news' ? entry.data : null;
const guide = entry.collection === 'guides' ? entry.data : null;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': isNews ? 'NewsArticle' : isMyth ? 'ClaimReview' : 'TechArticle',
  headline: data.title,
  description: data.description,
  inLanguage: 'tr-TR',
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@type': 'Organization', name: data.author, url: SITE.url },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  articleSection: category?.name,
  keywords: data.tags.join(', '),
};
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.seoDescription ?? data.description}
  ogType="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  structuredData={structuredData}
  noindex={data.status !== 'published'}
>
  <article class="container-reading article">
    <nav aria-label="Konum" class="breadcrumb">
      <a href="/">Ana sayfa</a>
      <span aria-hidden="true">/</span>
      <a href={section.href}>{section.label}</a>
      {
        category && (
          <>
            <span aria-hidden="true">/</span>
            <a href={`/konular/${category.id}/`}>{category.name}</a>
          </>
        )
      }
    </nav>

    <header class="article-head">
      {
        myth && (
          <div class="verdict-row">
            <VerdictBadge verdict={myth.verdict as Verdict} size="large" />
            <p class="verdict-line">{myth.verdictLine}</p>
          </div>
        )
      }

      <h1 class:list={[isMyth && 'claim']}>
        {isMyth ? <>&ldquo;{data.title}&rdquo;</> : data.title}
      </h1>
      <p class="article-lede">{data.description}</p>

      <div class="article-meta">
        <time datetime={data.publishedAt.toISOString()}>
          {formatTurkishDate(data.publishedAt)}
        </time>
        {
          data.updatedAt && (
            <span class="updated">Güncellendi: {formatTurkishDate(data.updatedAt)}</span>
          )
        }
        {guide && <span>{guide.readingTime} dk okuma</span>}
        {guide && <span>{DIFFICULTY_LABELS[guide.difficulty]}</span>}
        {data.status !== 'published' && <span class="draft-badge">{data.status}</span>}
      </div>
    </header>

    {
      data.summary && (
        <aside class="summary">
          <p class="eyebrow">Kısaca</p>
          <p>{data.summary}</p>
        </aside>
      )
    }

    {
      data.uiVerifiedAt && (
        <p class="ui-verified">
          Bu rehberdeki adımlar {formatTurkishDate(data.uiVerifiedAt)} tarihinde kontrol edildi.
          Uygulama arayüzleri değişebilir; bir adım eşleşmiyorsa yorumlarda bildirin.
        </p>
      )
    }

    <div class="prose">
      <slot />
    </div>

    {
      news && (
        <p class="source-line">
          Kaynak:{' '}
          <a href={news.sourceUrl} rel="noopener nofollow" target="_blank">
            {news.sourceName}
          </a>
        </p>
      )
    }

    <Share title={data.title} url={url} />

    {
      related.length > 0 && (
        <section class="related">
          <h2>İlgili rehberler</h2>
          <div class="related-grid">
            {related.map((item) => (
              <ArticleCard entry={item} headingLevel={3} />
            ))}
          </div>
        </section>
      )
    }

    <Comments slug={entry.id} />
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .breadcrumb {
    display: flex;
    gap: var(--sp-2);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-bottom: var(--sp-5);
  }

  .breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--cyan);
  }

  .article-head h1 {
    margin-bottom: var(--sp-4);
  }

  /* A myth's headline is a quoted claim, so it is set apart from the
     assertive voice the rest of the site uses for its own headings. */
  .article-head h1.claim {
    font-family: var(--font-body);
    font-style: italic;
    font-weight: 500;
    color: var(--text-muted);
    font-size: var(--step-3);
  }

  .verdict-row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-bottom: var(--sp-4);
  }

  .verdict-line {
    flex: 1 1 20rem;
    color: var(--text);
    font-size: var(--step-1);
  }

  .article-lede {
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 56ch;
  }

  .article-meta {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-4);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-faint);
  }

  .article-meta .updated {
    color: var(--green);
  }

  .draft-badge {
    color: var(--amber);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .summary {
    margin-top: var(--sp-5);
    max-width: var(--measure);
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--cyan);
    border-radius: var(--radius);
  }

  .summary p:last-child {
    margin-top: var(--sp-2);
  }

  .ui-verified {
    margin-top: var(--sp-4);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  /* --- article body --- */

  .prose {
    margin-top: var(--sp-6);
    max-width: var(--measure);
    font-size: var(--step-0);
    line-height: 1.75;
  }

  .prose :global(h2) {
    font-size: var(--step-2);
    margin-top: var(--sp-7);
    margin-bottom: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
  }

  .prose :global(h3) {
    font-size: var(--step-1);
    margin-top: var(--sp-5);
    margin-bottom: var(--sp-2);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--sp-5);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--sp-5);
  }

  .prose :global(li) {
    margin-bottom: var(--sp-2);
  }

  .prose :global(ol) {
    counter-reset: step;
  }

  .prose :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--border-strong);
    padding-left: var(--sp-4);
    color: var(--text-muted);
    margin-bottom: var(--sp-4);
  }

  .prose :global(img) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-block: var(--sp-5);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--step--1);
    margin-bottom: var(--sp-5);
  }

  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--sp-3);
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .prose :global(th) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .source-line {
    margin-top: var(--sp-5);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .related {
    margin-top: var(--sp-7);
  }

  .related h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-4);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--sp-4);
  }
</style>
