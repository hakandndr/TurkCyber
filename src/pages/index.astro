---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import MythCard from '../components/MythCard.astro';
import { PRIMARY_CATEGORIES, SECONDARY_CATEGORIES, SITE } from '../config/site';
import { getFeaturedGuides, getGuides, getMyths, getNews, getTechnical } from '../lib/content';
import { HOME_TITLE, ldGraph, websiteLd } from '../lib/seo';

const [featured, guides, news, myths, technical] = await Promise.all([
  getFeaturedGuides(3),
  getGuides(),
  getNews(),
  getMyths(),
  getTechnical(),
]);

const featuredIds = new Set(featured.map((g) => g.id));
const latest = guides.filter((g) => !featuredIds.has(g.id)).slice(0, 4);
const latestNews = news.slice(0, 3);
const topMyths = myths.slice(0, 3);
const topTechnical = technical.slice(0, 3);

/**
 * Quick access.
 *
 * Phrased as the sentence a worried person would actually type or say, not as
 * a category name. Someone arriving mid-panic should recognise their situation
 * without first learning what "phishing" or "2FA" means.
 *
 * Every destination here already exists — nothing links to a planned page.
 */
const QUICK_ACCESS = [
  {
    href: '/konular/instagram-sosyal-medya/',
    label: 'Instagram hesabımı koru',
    detail: 'Ele geçirilmeye karşı ayarlar ve sahte destek mesajları',
    accent: 'cyan' as const,
  },
  {
    href: '/araclar/bu-mesaj-sahte-mi/',
    label: 'Bu mesaj sahte mi?',
    detail: 'Altı gerçekçi örnekle kısa test — tarayıcınızda çalışır',
    accent: 'green' as const,
  },
  {
    href: '/rehberler/parayi-dolandiriciya-gonderdim-ne-yapmaliyim/',
    label: 'Dolandırıcıya para gönderdim',
    detail: 'İlk saatlerde sırayla yapılacaklar',
    accent: 'green' as const,
  },
  {
    href: '/rehberler/guvenli-hesap-dolandiriciligi/',
    label: 'Bankadan aradıklarını söylüyorlar',
    detail: '"Güvenli hesaba aktarın" senaryosu ve tek kural',
    accent: 'cyan' as const,
  },
  {
    href: '/konular/hesap-guvenligi/',
    label: 'Hesabımı nasıl güvene alırım?',
    detail: 'Şifre, iki aşamalı doğrulama ve kurtarma ayarları',
    accent: 'green' as const,
  },
  {
    href: '/rehberler/telefonunuz-kaybolursa-ilk-15-dakika/',
    label: 'Telefonumu kaybettim',
    detail: 'İlk 15 dakikada sırayla yapılacaklar',
    accent: 'cyan' as const,
  },
];

const structuredData = ldGraph(websiteLd());
---

<BaseLayout title={SITE.name} seoTitle={HOME_TITLE} description={SITE.description} {structuredData}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Türkçe dijital güvenlik rehberleri</p>
        <h1>{SITE.tagline}</h1>
        <p class="hero-lede">{SITE.description}</p>
        <div class="hero-actions">
          <a href="/rehberler/" class="button button-primary">Rehberlere göz at</a>
          <a href="/efsane-mi-gercek-mi/" class="button">Efsane mi, gerçek mi?</a>
        </div>
      </div>

      {
        /*
        Decorative, and deliberately factual: it shows this domain's real
        registration year rather than inventing a command-line tool TurkCyber
        does not ship. Hidden from assistive technology and from narrow
        viewports, where it would only cost vertical space.

        The body is structured records, not prose. It carried sentences split
        by hand across several `#` comment lines, which meant the wrapping was
        arbitrary and every wording change re-broke it. Records suit the form:
        a whois response is a key/value listing, so the card now reads as one
        instead of as a paragraph wearing a terminal costume. A continuation
        line indents under the VALUE column, never under the label.

        It also used to say "uzun bir aradan sonra yeniden yayında", which made
        the first thing a visitor read an apology for a gap nobody asked about.
        The dormant period is stated honestly on /hakkinda/, where there is
        room for it and where someone is actually asking.
      */
      }
      <aside class="hero-aside" aria-hidden="true">
        <div class="term">
          <span class="term-bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          </span>
          <pre><span class="p">$</span> whois turkcyber.com

<span class="k">domain</span>      TurkCyber.com
<span class="k">created</span>     <span class="hl">2005</span>
<span class="k">status</span>      active
<span class="k">origin</span>      Siber güvenlik topluluğu
<span class="k">today</span>       Rehberler · açıklamalar · araçlar
<span class="k">mission</span>     Dijital güvenliği anlaşılır
            hale getirmek

<span class="p">$</span> <span class="cursor">_</span></pre>
        </div>
      </aside>
    </div>
  </section>

  <!-- Quick access sits directly under the hero, above everything editorial:
       someone with an urgent problem should not have to scroll past a shelf of
       articles to find the door marked with their situation. -->
  <section class="container quick" aria-labelledby="quick-heading">
    <h2 id="quick-heading" class="section-title">Sık karşılaşılan durumlar</h2>
    <ul class="quick-grid">
      {
        QUICK_ACCESS.map((item) => (
          <li>
            <a href={item.href} class:list={['quick-card', `quick-${item.accent}`]}>
              <span class="quick-label">{item.label}</span>
              <span class="quick-detail">{item.detail}</span>
              <span class="quick-arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="section-title">Öne çıkan rehberler</h2>
    <div class="grid grid-lead">
      {
        featured.map((entry, index) => (
          <ArticleCard entry={entry} size={index === 0 ? 'lead' : 'default'} />
        ))
      }
    </div>
  </section>

  {
    topMyths.length > 0 && (
      <section class="container section myths-section" aria-labelledby="myths-heading">
        <div class="section-head">
          <h2 id="myths-heading" class="section-title">
            Efsane mi, gerçek mi?
          </h2>
          <a href="/efsane-mi-gercek-mi/" class="section-more">
            Hepsi →
          </a>
        </div>
        <p class="section-lede">
          Herkesin duyduğu ama çoğu yanlış olan cümleler. Cevap başlığın hemen altında.
        </p>
        <div class="myth-list">
          {topMyths.map((entry) => (
            <MythCard entry={entry} headingLevel={3} />
          ))}
        </div>
      </section>
    )
  }

  <section class="container section" aria-labelledby="topics-heading">
    <h2 id="topics-heading" class="section-title">Konular</h2>
    <ul class="topics">
      {
        PRIMARY_CATEGORIES.map((category) => (
          <li>
            <a href={`/konular/${category.id}/`} class:list={['topic', `topic-${category.accent}`]}>
              <span class="topic-question">{category.question}</span>
              <span class="topic-name">{category.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="topics-secondary">
      {
        SECONDARY_CATEGORIES.map((category) => (
          <li>
            <a href={`/konular/${category.id}/`}>{category.name}</a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    topTechnical.length > 0 && (
      <section class="container section" aria-labelledby="technical-heading">
        <div class="section-head">
          <h2 id="technical-heading" class="section-title">
            Nasıl çalışıyor?
          </h2>
          <a href="/teknik/" class="section-more">
            Hepsi →
          </a>
        </div>
        <p class="section-lede">
          Ne yapmanız gerektiğini değil, neden öyle olduğunu anlatan yazılar.
          <span class="lane-badge">İLERİ SEVİYE</span>
        </p>
        <div class="grid">
          {topTechnical.map((entry) => (
            <ArticleCard entry={entry} headingLevel={3} />
          ))}
        </div>
      </section>
    )
  }

  <section class="container section" aria-labelledby="latest-heading">
    <h2 id="latest-heading" class="section-title">Yeni rehberler</h2>
    <div class="grid">
      {latest.map((entry) => <ArticleCard entry={entry} />)}
    </div>
  </section>

  {
    /*
     * The section renders whether or not there is anything in it. An area that
     * silently disappears when empty tells a returning visitor nothing; a
     * designed empty state tells them the shelf exists and is not stocked with
     * filler. Fabricating a news item to fill it is not an option — see
     * CLAUDE.md, content rules.
     */
    latestNews.length === 0 && (
      <section class="container section" aria-labelledby="news-empty-heading">
        <div class="section-head">
          <h2 id="news-empty-heading" class="section-title">
            Güncel güvenlik haberleri
          </h2>
          <a href="/haberler/" class="section-more">
            Bölüm →
          </a>
        </div>
        <p class="news-empty">
          Henüz yayınlanmış güncel güvenlik haberi yok. Buraya yalnızca hesaplarınızı veya
          cihazlarınızı doğrudan ilgilendiren gelişmeleri yazıyoruz.
        </p>
      </section>
    )
  }

  {
    latestNews.length > 0 && (
      <section class="container section" aria-labelledby="news-heading">
        <h2 id="news-heading" class="section-title">
          Güncel güvenlik haberleri
        </h2>
        <div class="grid">
          {latestNews.map((entry) => (
            <ArticleCard entry={entry} size="compact" />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    /* Two soft pools of accent rather than a gradient wash across the band. */
    background:
      radial-gradient(64ch 40ch at 8% -20%, rgba(33, 230, 122, 0.08), transparent 68%),
      radial-gradient(52ch 34ch at 92% -10%, rgba(0, 200, 255, 0.06), transparent 68%);
  }

  .hero-inner {
    padding-block: clamp(var(--sp-7), 6vw, calc(var(--sp-8) * 1.4));
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: center;
  }

  @media (min-width: 1040px) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
  }

  .hero h1 {
    margin-top: var(--sp-3);
    max-width: 16ch;
  }

  /* --- hero aside --- */

  .hero-aside {
    display: none;
  }

  @media (min-width: 1040px) {
    .hero-aside {
      display: block;
      justify-self: end;
      width: 100%;
      max-width: 30rem;
    }
  }

  .term {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface-1) 82%, transparent);
    overflow: hidden;
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .term-bar {
    display: flex;
    gap: 6px;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border-strong);
  }

  .term pre {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: var(--sp-5);
    font-size: 0.82rem;
    line-height: 1.75;
    color: var(--text-muted);
    overflow-x: auto;
  }

  .term .p {
    color: var(--green);
  }

  .term .hl {
    color: var(--text);
    font-weight: 500;
  }

  /* Record keys. Recessive, so the values are what the eye reads. */
  .term .k {
    color: var(--text-faint);
  }

  .term .c {
    color: var(--text-faint);
  }

  .term .cursor {
    color: var(--green);
    animation: blink 1.3s steps(2, start) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .term .cursor {
      animation: none;
    }
  }

  .hero-lede {
    margin-top: var(--sp-5);
    color: var(--text-muted);
    font-size: var(--step-1);
    max-width: 58ch;
  }

  .hero-text {
    max-width: none;
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    margin-top: var(--sp-6);
  }

  .section {
    padding-block: var(--sp-7);
  }

  .section-title {
    font-size: var(--step-2);
    margin-bottom: var(--sp-5);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .section-head .section-title {
    margin-bottom: var(--sp-2);
  }

  .section-more {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
  }

  .section-more:hover {
    color: var(--cyan);
  }

  /* The technical lane is labelled wherever it is linked, not only on its own
     page — a reader should know what they are clicking into. */
  .lane-badge {
    display: inline-block;
    margin-left: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--cyan);
    border: 1px solid var(--border-strong);
    border-radius: 3px;
    padding: 0.15em 0.45em;
    vertical-align: middle;
  }

  .news-empty {
    max-width: 60ch;
    padding: var(--sp-5);
    color: var(--text-muted);
    background: var(--surface-1);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .section-lede {
    color: var(--text-muted);
    margin-bottom: var(--sp-5);
    max-width: 60ch;
  }

  /* --- quick access --- */

  .quick {
    padding-block: var(--sp-7) var(--sp-5);
  }

  .quick-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--sp-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quick-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    transition: transform 0.14s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-card {
      transition: none;
    }
  }

  .quick-card:hover {
    background: var(--surface-2);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .quick-green:hover {
    border-color: rgba(33, 230, 122, 0.5);
  }
  .quick-cyan:hover {
    border-color: rgba(0, 200, 255, 0.45);
  }

  .quick-label {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
    line-height: 1.3;
    padding-right: var(--sp-5);
  }

  .quick-detail {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .quick-arrow {
    position: absolute;
    top: var(--sp-5);
    right: var(--sp-5);
    color: var(--text-faint);
    font-size: var(--step-0);
  }

  .quick-card:hover .quick-arrow {
    color: var(--green);
  }

  /* --- shelves --- */

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
  }

  /* The lead card spans two tracks, so the shelf needs a fixed column count
     rather than auto-fit for the span to mean anything. */
  .grid-lead {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 900px) {
    .grid-lead {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .grid-lead {
      grid-template-columns: 1fr;
    }
  }

  .myths-section {
    border-block: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(0, 200, 255, 0.03), transparent 60%);
  }

  .myth-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  /* --- topics --- */

  .topics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .topic {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border-strong);
    border-radius: var(--radius);
    text-decoration: none;
  }

  .topic-green {
    border-left-color: var(--green);
  }
  .topic-cyan {
    border-left-color: var(--cyan);
  }

  .topic:hover {
    background: var(--surface-2);
  }

  /* The question leads, the taxonomy label follows — a visitor recognises the
     situation before the category name. */
  .topic-question {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
  }

  .topic-name {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .topics-secondary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    list-style: none;
    padding: 0;
    margin-top: var(--sp-4);
  }

  .topics-secondary a {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.4em 1em;
    display: inline-block;
    min-height: 36px;
    line-height: 1.6;
  }

  .topics-secondary a:hover {
    color: var(--cyan);
    border-color: var(--border-strong);
  }
</style>
