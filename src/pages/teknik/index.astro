---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getTechnical } from '../../lib/content';
import { breadcrumbLd, collectionPageLd, ldGraph } from '../../lib/seo';

/**
 * "Nasıl çalışıyor?" — the technical-depth lane.
 *
 * Kept as its own surface rather than a difficulty filter on the guides,
 * because the reader's intention is different. A guide answers "what do I
 * do"; these answer "why does that work". Mixing them makes the guides feel
 * heavier than they are and buries the explanations.
 */
const entries = await getTechnical();

const description =
  'Bir saldırının arkasında teknik olarak ne olduğunu anlatan yazılar: oturum çerezleri, ' +
  'tek kullanımlık kodlar, alan adı benzerliği ve uygulama izinleri.';

const structuredData = ldGraph(
  collectionPageLd('Teknik Derinlik', '/teknik/', description),
  breadcrumbLd([
    { name: 'Ana sayfa', path: '/' },
    { name: 'Teknik Derinlik', path: '/teknik/' },
  ]),
);
---

<BaseLayout title="Teknik Derinlik: Nasıl çalışıyor?" {description} {structuredData}>
  <div class="container page">
    <header class="page-head">
      <p class="eyebrow">İleri seviye</p>
      <h1>Nasıl çalışıyor?</h1>
      <p class="lede">
        Sitenin geri kalanı ne yapmanız gerektiğini anlatıyor. Burası arayüzün arkasında ne olduğunu
        anlatıyor: bir isteğin hangi bileşenlerden geçtiğini, bir korumanın neden işe yaradığını,
        hangi katmanda hangi varsayımın çöktüğünü ve saldırganın gerçekte neyi hedeflediğini.
      </p>
      <dl class="system-strip lane-system">
        <div><dt>Yayın türü</dt><dd>Teknik açıklama</dd></div>
        <div><dt>Kapsam</dt><dd>İstek · kimlik · oturum</dd></div>
        <div><dt>Derinlik</dt><dd>İleri seviye</dd></div>
        <div><dt>Kayıt</dt><dd>{entries.length} araştırma notu</dd></div>
      </dl>
      <ul class="lane-marks">
        <li>İstek ve yanıt akışları — tarayıcıdan oturum kaydına kadar</li>
        <li>Gerçek HTTP başlıkları, çerez öznitelikleri ve oturum yaşam döngüsü</li>
        <li>Kimlik doğrulama, ek doğrulama ve kurtarma akışlarının durum geçişleri</li>
        <li>Güvenlik sınırları: her katmanın dayandığı varsayım ve düştüğünde olan</li>
      </ul>
      <p class="note">
        İki kural: bu yazılar bir saldırının nasıl yapılacağını değil nasıl işlediğini anlatır —
        adım adım saldırı tarifi bulamazsınız. Ve bir şirketin kamuya açık olmayan iç tasarımı
        hakkında iddiada bulunmayız; gözlemlenebilir davranış ile onu açıklayan sektör standardı
        model ayrı ayrı belirtilir.
      </p>
    </header>

    {
      entries.length > 0 ? (
        <div class="grid">
          {entries.map((entry, index) => (
            <div class="technical-entry">
              <span class="entry-index" aria-hidden="true">
                NOT / {String(index + 1).padStart(2, '0')}
              </span>
              <ArticleCard entry={entry} headingLevel={2} />
            </div>
          ))}
        </div>
      ) : (
        <p class="empty">Bu bölüm henüz hazırlanıyor.</p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .page-head {
    margin-bottom: var(--sp-7);
    padding-left: var(--sp-4);
    border-left: var(--trace-thickness) solid var(--interaction-accent);
  }
  .page-head > :not(.lane-system) {
    max-width: var(--measure);
  }
  .lane-system {
    margin-top: var(--sp-5);
  }
  .page-head h1 {
    margin-top: var(--sp-2);
  }
  .lede {
    margin-top: var(--sp-4);
    color: var(--text-muted);
    font-size: var(--step-1);
  }
  .lane-marks {
    margin-top: var(--sp-4);
    padding-left: var(--sp-5);
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.7;
  }
  .lane-marks li {
    margin-bottom: var(--sp-2);
  }
  .note {
    margin-top: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand-accent-strong);
    border-radius: var(--radius);
    background: var(--surface-1);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5) var(--sp-4);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }
  .technical-entry {
    position: relative;
    min-width: 0;
  }
  .technical-entry::before {
    content: '';
    position: absolute;
    top: calc(-1 * var(--sp-5) - 2px);
    left: 0;
    width: var(--trace-node-size);
    height: var(--trace-node-size);
    background: var(--interaction-accent);
  }
  .entry-index {
    display: block;
    margin-bottom: var(--sp-2);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }

  @media (max-width: 56rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 38rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .empty {
    color: var(--text-muted);
  }
</style>
