---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getNews } from '../../lib/content';
import { breadcrumbLd, collectionPageLd, ldGraph } from '../../lib/seo';

const news = await getNews();

const description =
  'Sizi doğrudan etkileyebilecek sızıntılar, saldırılar ve platform güvenlik değişiklikleri.';

const structuredData = ldGraph(
  collectionPageLd('Haberler', '/haberler/', description),
  breadcrumbLd([
    { name: 'Ana sayfa', path: '/' },
    { name: 'Haberler', path: '/haberler/' },
  ]),
);
---

<BaseLayout
  title="Haberler"
  seoTitle="Güvenlik Haberleri | TurkCyber"
  {description}
  {structuredData}
>
  <div class="container page">
    <header class="page-head">
      <h1>Haberler</h1>
      <p>
        Genel teknoloji haberleri yayınlamıyoruz. Burada yalnızca hesaplarınızı veya cihazlarınızı
        doğrudan ilgilendiren gelişmeler yer alır.
      </p>
    </header>

    {
      news.length > 0 ? (
        <div class="grid">
          {news.map((entry) => (
            <ArticleCard entry={entry} />
          ))}
        </div>
      ) : (
        <p class="empty">
          Henüz yayınlanmış güncel güvenlik haberi yok. Yalnızca sizi doğrudan ilgilendiren bir
          gelişme olduğunda buraya yazıyoruz.
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .page-head {
    max-width: var(--measure);
    margin-bottom: var(--sp-6);
  }
  .page-head p {
    margin-top: var(--sp-3);
    color: var(--text-muted);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-4);
  }
  .empty {
    color: var(--text-muted);
  }
</style>
