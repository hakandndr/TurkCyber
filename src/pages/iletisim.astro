---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT_FORM, SITE, resolveFormspreeEndpoint } from '../config/site';

/**
 * Contact form.
 *
 * Posts to Formspree. The endpoint lives in src/config/site.ts as public
 * configuration — it appears in the form's `action` attribute and is visible
 * to every visitor, so it is not a secret. PUBLIC_FORMSPREE_ENDPOINT can
 * override it per environment.
 *
 * `resolveFormspreeEndpoint` returns an empty string for anything that is not
 * a well-formed Formspree URL, and the page then renders the email address
 * instead of a form. A form posting to a malformed endpoint would accept
 * messages and discard them silently, which is worse than no form.
 */
const formspreeEndpoint = resolveFormspreeEndpoint(import.meta.env.PUBLIC_FORMSPREE_ENDPOINT);
const formEnabled = formspreeEndpoint !== '';
---

<BaseLayout
  title="İletişim"
  description="TurkCyber ile iletişime geçin: düzeltmeler, öneriler ve içerik talepleri."
>
  <div class="container-narrow page">
    <h1>İletişim</h1>

    <p class="lede">Düzeltme, öneri veya rehber talebi için yazabilirsiniz. Her mesajı okuyoruz.</p>

    {
      formEnabled ? (
        <form class="contact-form" method="post" action={formspreeEndpoint} data-contact-form>
          <div class="field">
            <label for="name">Adınız</label>
            <input id="name" name="name" type="text" required maxlength="80" autocomplete="name" />
          </div>

          <div class="field">
            <label for="email">E-posta adresiniz</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength="120"
              autocomplete="email"
            />
            <p class="field-note">Yalnızca size yanıt verebilmemiz için. Yayınlanmaz.</p>
          </div>

          <div class="field">
            <label for="subject">Konu</label>
            <input id="subject" name="subject" type="text" required maxlength="120" />
          </div>

          <div class="field">
            <label for="message">Mesajınız</label>
            <textarea
              id="message"
              name="message"
              required
              minlength="10"
              maxlength="4000"
              rows="7"
            />
          </div>

          {/*
            Honeypot. Real people never see this field and never fill it, so a
            submission carrying a value is almost certainly automated. Formspree
            drops submissions where a field named `_gotcha` is non-empty.
            Hidden with CSS rather than `type="hidden"` — bots fill visible-in-
            markup fields and skip genuinely hidden inputs.
          */}
          <div class="gotcha" aria-hidden="true">
            <label for="contact-gotcha">Bu alanı boş bırakın</label>
            <input
              id="contact-gotcha"
              type="text"
              name={CONTACT_FORM.honeypotField}
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <div class="actions">
            <button type="submit" class="button button-primary">
              Gönder
            </button>
            <p class="form-status" data-form-status role="status" />
          </div>
        </form>
      ) : (
        <p class="mail">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      )
    }

    <h2>Ne yazabilirsiniz</h2>
    <ul>
      <li>Bir rehberdeki adım artık eşleşmiyorsa — hangi rehber, hangi adım.</li>
      <li>Yayınlamamızı istediğiniz bir konu varsa.</li>
      <li>Bir yazıda hata veya eksik gördüyseniz.</li>
      <li>Bir iddianın doğru olup olmadığını merak ediyorsanız.</li>
    </ul>

    <h2>Ne yapamayız</h2>
    <p>
      <strong>Kişisel hesap kurtarma desteği veremiyoruz.</strong> Hesabınız ele geçirildiyse bize yazmak
      süreci hızlandırmaz; kurtarma yalnızca ilgili platformun kendi akışıyla mümkündür. Bu konudaki rehberlerimiz
      <a href="/konular/hesap-guvenligi/">Hesap Güvenliği</a> başlığı altında.
    </p>
    <p>
      Acil bir durumdaysanız bize yazmadan önce şunu yapın: hesabınızın şifresini değiştirin ve tüm
      cihazlardan çıkış yapın.
    </p>
    <p class="alt-mail">
      Formu kullanmak istemiyorsanız doğrudan
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a> adresine yazabilirsiniz.
    </p>
  </div>
</BaseLayout>

<script>
  /*
   * Progressive enhancement only. Without JavaScript the form is a plain POST
   * to Formspree, which renders its own confirmation page — the flow still
   * works, it just leaves the site.
   */
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');

  if (form && status) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      submit.disabled = true;
      status.textContent = 'Gönderiliyor…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });

        if (response.ok) {
          form.reset();
          status.textContent = 'Mesajınız iletildi. Teşekkürler.';
        } else {
          status.textContent = 'Mesaj gönderilemedi. Doğrudan e-posta ile yazabilirsiniz.';
        }
      } catch {
        status.textContent = 'Mesaj gönderilemedi. Bağlantınızı kontrol edin.';
      } finally {
        submit.disabled = false;
      }
    });
  }
</script>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }

  .lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-block: var(--sp-4) var(--sp-6);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    margin-bottom: var(--sp-7);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .field label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .field input,
  .field textarea {
    font: inherit;
    background: var(--surface-2);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7em 0.8em;
    width: 100%;
    min-height: 44px;
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field-note {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  /* Off-screen rather than display:none — some bots skip fields that are not
     rendered at all, and this needs to look fillable to them. */
  .gotcha {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .form-status {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .mail {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand-accent-strong);
    border-radius: var(--radius);
    padding: var(--sp-4);
    margin-block: var(--sp-5) var(--sp-7);
  }

  .page h2 {
    font-size: var(--step-2);
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-3);
  }

  .page p,
  .page ul {
    margin-bottom: var(--sp-4);
  }

  .page ul {
    padding-left: var(--sp-5);
  }

  .page li {
    margin-bottom: var(--sp-2);
  }

  .alt-mail {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
</style>
