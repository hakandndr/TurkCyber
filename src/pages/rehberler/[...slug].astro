---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import Callout from '../../components/Callout.astro';
import { getGuides, relatedGuides } from '../../lib/content';

export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, related: relatedGuides(entry, guides) },
  }));
}

const { entry, related } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout entry={entry} related={related}>
  <Content components={{ Callout }} />
</ArticleLayout>
