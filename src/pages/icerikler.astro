---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORIES, CONTENT_AREAS } from '../config/site';
import { breadcrumbLd, collectionPageLd, ldGraph } from '../lib/seo';
import { getAllArticles } from '../lib/content';
import { READY_TOOLS } from '../config/tools';

/**
 * The İçerikler hub.
 *
 * Exists so the grouped navigation has a destination. A parent label that only
 * opens a menu is a dead end for anyone using a keyboard, a screen reader, or
 * a touch device that resolves the first tap as a click — and it gives search
 * engines a navigation item with nothing behind it.
 *
 * Deliberately thin: one line per area and a real count, not a second copy of
 * each section's own listing. Counts come from the content collections, so a
 * new guide is reflected here without anyone remembering to edit this file.
 */
const articles = await getAllArticles();
const countOf = (collection: string): number =>
  articles.filter((entry) => entry.collection === collection).length;

const COUNTS: Record<string, string> = {
  '/rehberler/': `${countOf('guides')} rehber`,
  '/efsane-mi-gercek-mi/': `${countOf('myths')} iddia`,
  '/araclar/': `${READY_TOOLS.length} araç`,
  '/konular/': `${CATEGORIES.length} konu`,
  '/haberler/': countOf('news') > 0 ? `${countOf('news')} haber` : 'Henüz yayın yok',
};

const description =
  'TurkCyber içeriklerinin tamamı: rehberler, efsane mi gerçek mi, araçlar, konu dizini ve haberler.';

const structuredData = ldGraph(
  collectionPageLd('İçerikler', '/icerikler/', description),
  breadcrumbLd([
    { name: 'Ana sayfa', path: '/' },
    { name: 'İçerikler', path: '/icerikler/' },
  ]),
);
---

<BaseLayout title="İçerikler" seoTitle="İçerikler | TurkCyber" {description} {structuredData}>
  <div class="container-narrow page">
    <header class="page-head">
      <p class="eyebrow">İçerikler</p>
      <h1>Nereden başlamak istersiniz?</h1>
      <p class="lede">
        Sitedeki her şey beş başlık altında. Bir sorununuz varsa rehberlerle, bir cümlenin doğru
        olup olmadığını merak ediyorsanız efsanelerle başlayın.
      </p>
      <dl class="system-strip hub-strip">
        <div><dt>Yapı</dt><dd>{CONTENT_AREAS.length} içerik alanı</dd></div>
        <div><dt>Sayım</dt><dd>Derleme anında güncel</dd></div>
        <div><dt>Teknik rota</dt><dd>/teknik/</dd></div>
      </dl>
    </header>

    <ul class="areas">
      {
        CONTENT_AREAS.map((area, index) => (
          <li>
            <a href={area.href} class="trace-surface">
              <span class="area-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="area-main">
                <span class="area-name">{area.label}</span>
                <span class="area-blurb">{area.blurb}</span>
              </span>
              <span class="area-meta">
                <span class="area-status">Rota açık</span>
                <span class="area-count">{COUNTS[area.href]}</span>
                <span class="area-route">{area.href}</span>
                <span class="area-arrow" aria-hidden="true">
                  →
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="aside-note">
      Bir mekanizmanın teknik olarak nasıl işlediğini merak ediyorsanız
      <a href="/teknik/">Teknik Derinlik</a> bölümü ayrı duruyor.
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--sp-6) var(--sp-8);
  }
  .page-head {
    margin-bottom: var(--sp-6);
  }
  .hub-strip {
    margin-top: var(--sp-5);
  }
  .page-head h1 {
    margin-top: var(--sp-2);
  }
  .lede {
    margin-top: var(--sp-4);
    color: var(--text-muted);
    font-size: var(--step-1);
  }
  .areas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    border-bottom: 1px solid var(--border);
  }
  .areas a {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) minmax(10rem, auto);
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-5) var(--sp-4);
    background: color-mix(in srgb, var(--surface-1) 74%, transparent);
    border: 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
  }

  .area-index {
    align-self: stretch;
    display: flex;
    align-items: flex-start;
    padding-top: 0.18rem;
    border-right: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--brand-accent-strong);
  }
  .area-main,
  .area-meta {
    display: flex;
    min-width: 0;
  }
  .area-main {
    flex-direction: column;
    gap: var(--sp-2);
  }
  .area-meta {
    justify-content: flex-end;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-align: right;
  }
  .area-name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text);
  }
  .area-count {
    color: var(--text-faint);
  }
  .area-status {
    color: var(--green);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .area-route {
    color: var(--text-muted);
  }
  .area-arrow {
    color: var(--brand-accent-strong);
  }
  .area-blurb {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.6;
  }
  .aside-note {
    margin-top: var(--sp-6);
    color: var(--text-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 44rem) {
    .areas a {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      padding-inline: 0;
    }

    .area-meta {
      grid-column: 2;
      justify-content: flex-start;
      text-align: left;
    }
  }
</style>
