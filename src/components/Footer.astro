---
/**
 * Site footer.
 *
 * Three semantic columns, each a distinct kind of information:
 *
 *   1. Brand and heritage   — who this is
 *   2. Navigation           — where to go
 *   3. Contact and DNDR     — how to reach a person
 *
 * The previous single-row layout put the navigation links and the contact
 * metadata in adjacent columns with identical styling, so "Gizlilik" and
 * "admin@turkcyber.com" read as one list. Each column now carries its own
 * heading and the contact block is visually distinct from the link list.
 *
 * The vertical rhythm is tighter than it was. The three-group structure
 * survives untouched — the change is spacing only: the footer was taking a
 * screenful on a phone, which pushes the last thing a reader wants (contact,
 * privacy) below yet another scroll.
 */
import { FOOTER_LINKS, HERITAGE, SITE } from '../config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="col col-brand" aria-labelledby="footer-brand-heading">
      <h2 id="footer-brand-heading" class="visually-hidden">TurkCyber</h2>
      <Logo variant="compact" />
      <p class="footer-tagline">Türkçe dijital güvenlik rehberleri.</p>
      <p class="footer-heritage">{HERITAGE.footer}</p>
    </section>

    <nav class="col col-nav" aria-labelledby="footer-nav-heading">
      <h2 id="footer-nav-heading" class="col-heading">Site</h2>
      <ul class="footer-links">
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="col col-contact" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="col-heading">İletişim</h2>
      <a class="contact-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p class="contact-note">Kişisel hesap kurtarma desteği veremiyoruz.</p>
      <a class="dndr" href={SITE.owner.url} rel="noopener">
        <span class="dndr-mark" aria-hidden="true"></span>
        A DNDR Labs Project
      </a>
    </section>
  </div>

  <div class="container footer-base">
    <span>&copy; {year} TurkCyber</span>
    <span class="founded">Kuruluş: {HERITAGE.foundedYear}</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface-1);
    padding-block: var(--sp-5) var(--sp-4);
    font-size: var(--step--1);
  }

  .footer-grid {
    display: grid;
    /* Brand column carries more text, so it takes the wider track. */
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: var(--sp-4) var(--sp-6);
    align-items: start;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
  }

  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0;
  }

  .footer-tagline {
    color: var(--text-muted);
    max-width: 34ch;
  }

  .footer-heritage {
    color: var(--text-faint);
    font-size: 0.8rem;
    line-height: 1.6;
    max-width: 46ch;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--cyan);
  }

  /* The contact column is deliberately styled unlike the link list, so the
     address is never mistaken for another navigation item. */
  .contact-mail {
    font-family: var(--font-mono);
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 2px;
    align-self: flex-start;
    word-break: break-all;
  }

  .contact-mail:hover {
    color: var(--cyan);
    border-bottom-color: var(--cyan);
  }

  .contact-note {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 32ch;
  }

  .dndr {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .dndr-mark {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--green);
    flex: none;
  }

  .dndr:hover {
    color: var(--green);
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-4) var(--sp-5);
    }
    .col-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }
  }
</style>
