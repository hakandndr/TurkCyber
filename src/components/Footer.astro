---
/**
 * Site footer.
 *
 * Three semantic columns, each a distinct kind of information:
 *
 *   1. Brand and heritage   — who this is
 *   2. Navigation           — where to go
 *   3. Contact and DNDR     — how to reach a person
 *
 * The previous single-row layout put the navigation links and the contact
 * metadata in adjacent columns with identical styling, so "Gizlilik" and
 * "admin@turkcyber.com" read as one list. Each column now carries its own
 * heading and the contact block is visually distinct from the link list.
 *
 * The vertical rhythm is tight on purpose: the footer was taking a screenful
 * on a phone, which pushes the last thing a reader wants (contact, privacy)
 * below yet another scroll.
 *
 * The brand column is three lines and stops. It used to carry a tagline, a
 * paragraph about the domain having been a 2005 forum that went quiet, and a
 * separate "Kuruluş: 2005" in the base row — three different ways of saying
 * the same date, one of them leading with an apology. The heritage line now
 * appears exactly once, in the column, as a continuity line.
 */
import { FOOTER_LINKS, HERITAGE, SITE } from '../config/site';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <section class="col col-brand" aria-labelledby="footer-brand-heading">
      <h2 id="footer-brand-heading" class="visually-hidden">TurkCyber</h2>
      <Logo variant="compact" />
      <p class="footer-mission">{HERITAGE.mission}</p>
      <p class="footer-heritage">{HERITAGE.badge}</p>
    </section>

    <nav class="col col-nav" aria-labelledby="footer-nav-heading">
      <h2 id="footer-nav-heading" class="col-heading">Site</h2>
      <ul class="footer-links">
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="col col-contact" aria-labelledby="footer-contact-heading">
      <h2 id="footer-contact-heading" class="col-heading">İletişim</h2>
      <a class="contact-mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <p class="contact-note">Kişisel hesap kurtarma desteği veremiyoruz.</p>
    </section>
  </div>

  <!--
    Two sides, both meaningful. The base row used to repeat the identity twice
    — a copyright line and the domain — while the DNDR credit sat in the
    contact column as if it were a way to get in touch. The credit belongs
    here; the domain was saying nothing the lockup had not already said.
  -->
  <div class="container footer-base">
    <span>&copy; {HERITAGE.foundedYear}&ndash;{year} TurkCyber</span>
    <a class="dndr" href={SITE.owner.url} rel="noopener">
      <span class="dndr-mark" aria-hidden="true"></span>
      A DNDR Labs Project
      <span class="dndr-arrow" aria-hidden="true">&#8599;</span>
    </a>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface-1);
    padding-block: var(--sp-5) var(--sp-4);
    font-size: var(--step--1);
  }

  /*
   * Start with one column and add columns only when each track has room.
   * Zero-floor tracks and wrapping keep long content inside the page.
   */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-5);
    align-items: start;
    /* A grid item can always be wider than its track unless this is set. */
    min-width: 0;
  }

  /* Medium: navigation and contact pair up, brand takes its own row. */
  @media (min-width: 40rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--sp-5) var(--sp-6);
    }
    .col-brand {
      grid-column: 1 / -1;
    }
  }

  /* Desktop: the three columns, once there is room for all of them. */
  @media (min-width: 64rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
      gap: var(--sp-4) var(--sp-6);
    }
    .col-brand {
      grid-column: auto;
    }
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    /* Content may wrap, but must never force the grid wider than the page. */
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .col-heading {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 0;
  }

  .footer-mission {
    color: var(--text-muted);
    max-width: 34ch;
  }

  .footer-heritage {
    color: var(--text-faint);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-links a {
    color: var(--text-muted);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--cyan);
  }

  /* The contact column is deliberately styled unlike the link list, so the
     address is never mistaken for another navigation item. */
  .contact-mail {
    font-family: var(--font-mono);
    max-width: 100%;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 2px;
    align-self: flex-start;
    word-break: break-all;
  }

  .contact-mail:hover {
    color: var(--cyan);
    border-bottom-color: var(--cyan);
  }

  .contact-note {
    color: var(--text-faint);
    font-size: 0.8rem;
    max-width: 32ch;
  }

  .dndr {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .dndr-mark {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    background: var(--green);
    flex: none;
  }

  .dndr:hover {
    color: var(--green);
  }

  .dndr-arrow {
    font-size: 0.9em;
    opacity: 0.75;
  }

  .footer-base {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
</style>
