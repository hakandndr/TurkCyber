---
/**
 * TurkCyber “Kod Parantezi” identity.
 *
 * Owner raster masters are canonical. This component renders only their
 * generated, hash-locked display derivatives and applies layout sizing.
 */
import identity from '../brand/identity.json';

interface Props {
  variant?: 'full' | 'compact';
  /** Compatibility prop: the full SVG already contains the approved signature. */
  heritage?: boolean;
  class?: string;
}

const { variant = 'full', class: className = '' } = Astro.props;
const isCompact = variant === 'compact';
const asset = isCompact ? identity.derived.emblem : identity.derived.lockup;
---

<span
  class:list={['brand-lockup', `brand-lockup-${variant}`, className]}
  role="img"
  aria-label="TurkCyber"
  data-brand-version={identity.version}
  data-brand-fingerprint={identity.metadata.fingerprint}
>
  <img
    class="brand-artwork"
    src={asset.publicPath}
    width={asset.dimensions[0]}
    height={asset.dimensions[1]}
    alt=""
    decoding="async"
  />
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1;
    text-decoration: none;
    min-width: 0;
  }

  .brand-artwork {
    display: block;
    height: 1.72rem;
    width: auto;
    line-height: 0;
    flex: none;
    object-fit: contain;
  }

  .brand-lockup-compact .brand-artwork {
    height: 1.42rem;
  }

  @media (max-width: 768px) {
    .brand-artwork {
      height: 1.4rem;
    }
  }

  @media (max-width: 380px) {
    .brand-artwork {
      height: 1.28rem;
    }
  }

  @media (forced-colors: active) {
    .brand-artwork {
      forced-color-adjust: auto;
    }
  }
</style>
