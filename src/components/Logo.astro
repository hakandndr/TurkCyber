---
/**
 * The TurkCyber mark: <tc/>
 *
 * `tc` is dominant; the angle brackets are muted; the slash carries the accent
 * and pulses slowly in the header.
 *
 * Rendered as text rather than SVG so it inherits the loaded monospace face and
 * stays crisp at any size. The favicon is a separate hand-built SVG — see
 * public/favicon.svg — because at 16px this composition is not legible.
 */
interface Props {
  /** `full` includes the wordmark; `compact` is the bracket mark alone. */
  variant?: 'full' | 'compact';
  /** Slow opacity pulse on the slash. Header only. */
  animated?: boolean;
  class?: string;
}

const { variant = 'full', animated = false, class: className = '' } = Astro.props;
---

<span class:list={['logo', `logo-${variant}`, className]} aria-label="TurkCyber">
  <span class="mark" aria-hidden="true">
    <span class="bracket">&lt;</span><span class="letters">tc</span><span
      class:list={['slash', animated && 'slash-pulse']}>/</span
    ><span class="bracket">&gt;</span>
  </span>
  {variant === 'full' && <span class="wordmark">TurkCyber</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    font-family: var(--font-mono);
    line-height: 1;
    text-decoration: none;
  }

  .mark {
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .bracket {
    color: var(--text-muted);
    font-weight: 500;
  }

  .letters {
    color: var(--text);
  }

  .slash {
    color: var(--green);
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  /* Slow, quiet. The mark should read as alive, not as a notification. */
  .slash-pulse {
    animation: slash-pulse 3.2s ease-in-out infinite;
  }

  @keyframes slash-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  /* Motion is decorative here; removing it costs nothing. */
  @media (prefers-reduced-motion: reduce) {
    .slash-pulse {
      animation: none;
    }
  }

  .logo-compact .mark {
    font-size: 1.25rem;
  }
</style>
