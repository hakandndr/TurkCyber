---
import { getCategory, DIFFICULTY_LABELS } from '../config/site';
import { articlePath, formatTurkishDate, type Article } from '../lib/content';

interface Props {
  entry: Article;
  /** Renders the headline as an h2 inside a list, or h3 in a sidebar. */
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 2 } = Astro.props;
const category = getCategory(entry.data.category);
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const difficulty =
  entry.collection === 'guides'
    ? DIFFICULTY_LABELS[entry.data.difficulty as keyof typeof DIFFICULTY_LABELS]
    : null;
const date = entry.data.updatedAt ?? entry.data.publishedAt;
---

<article class="card">
  <div class="card-meta">
    {category && <span class:list={['tag', `tag-${category.accent}`]}>{category.name}</span>}
    {difficulty && <span class="card-difficulty">{difficulty}</span>}
  </div>

  <Heading class="card-title">
    <a href={articlePath(entry)}>{entry.data.title}</a>
  </Heading>

  <p class="card-desc">{entry.data.description}</p>

  <p class="card-foot">
    <time datetime={date.toISOString()}>{formatTurkishDate(date)}</time>
    {entry.collection === 'guides' && <span>{entry.data.readingTime} dk okuma</span>}
    {entry.data.status !== 'published' && <span class="card-draft">{entry.data.status}</span>}
  </p>
</article>

<style>
  .card {
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  .card-meta {
    display: flex;
    gap: var(--sp-3);
    align-items: center;
    flex-wrap: wrap;
  }

  .card-difficulty {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .card-title {
    font-size: var(--step-1);
    line-height: 1.3;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is the target; the link stays the accessible name. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card {
    position: relative;
  }

  .card:hover .card-title a {
    color: var(--cyan);
  }

  .card-desc {
    color: var(--text-muted);
    font-size: var(--step--1);
    margin-bottom: auto;
  }

  .card-foot {
    display: flex;
    gap: var(--sp-4);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-faint);
    flex-wrap: wrap;
  }

  .card-draft {
    color: var(--amber);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
