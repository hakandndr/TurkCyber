---
/**
 * Site header.
 *
 * ── Why the navigation is grouped ────────────────────────────────────────
 *
 * It used to carry seven first-level destinations plus search. That reads as
 * an inventory of everything the site contains rather than as a way in, and on
 * a phone it became a horizontally scrolling strip — a pattern that hides
 * items behind a gesture nobody is told about.
 *
 * Five content sections now sit under "İçerikler", which is a real page at
 * /icerikler/ and not a dropdown trigger. Two rules follow from that and both
 * are deliberate:
 *
 *   - the LABEL is an ordinary link. Clicking it navigates.
 *   - the CHEVRON is a separate button. Clicking it opens the group.
 *
 * So the menu is never hover-only, keyboard users get a real button with
 * `aria-expanded`, and the group never becomes the only way to reach the page.
 *
 * The search control is unchanged from the version already approved.
 */
import Logo from './Logo.astro';
import { NAV } from '../config/site';

const path = Astro.url.pathname;
const isActive = (href: string): boolean => path === href || path.startsWith(href);

const groupActive = (item: (typeof NAV)[number]): boolean =>
  isActive(item.href) || ('children' in item && item.children.some((c) => isActive(c.href)));
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo-link" aria-label="TurkCyber ana sayfa">
      <Logo animated heritage />
    </a>

    <nav class="desktop-nav" aria-label="Ana menü">
      <ul class="nav">
        {
          NAV.map((item) =>
            'children' in item ? (
              <li class="nav-group" data-group>
                <span class="group-head">
                  <a
                    href={item.href}
                    class="group-link"
                    aria-current={groupActive(item) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                  <button
                    type="button"
                    class="group-toggle"
                    aria-expanded="false"
                    aria-controls="nav-group-icerikler"
                    aria-label={`${item.label} alt menüsünü aç`}
                    data-group-toggle
                  >
                    <svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
                      <path
                        d="M2.5 4.5 6 8l3.5-3.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </button>
                </span>

                <ul class="group-menu" id="nav-group-icerikler" data-group-menu hidden>
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                        <span class="group-menu-label">{child.label}</span>
                        <span class="group-menu-blurb">{child.blurb}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a
      href="/ara/"
      class="search-link"
      aria-label="Sitede ara"
      aria-haspopup="dialog"
      aria-controls="site-search-dialog"
      data-search-trigger
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.6-3.6"></path>
      </svg>
      <span class="search-label">Ara</span>
    </a>

    <button
      type="button"
      class="menu-button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Menü"
      data-menu-button
    >
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          class="icon-open"
        >
          <path d="M4 7h16"></path>
          <path d="M4 12h16"></path>
          <path d="M4 17h16"></path>
        </g>
        <g
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          class="icon-close"
        >
          <path d="M6 6l12 12"></path>
          <path d="M18 6L6 18"></path>
        </g>
      </svg>
    </button>
  </div>

  <span class="scroll-rail" aria-hidden="true">
    <span class="scroll-rail-line"></span>
    <span class="scroll-rail-node"></span>
  </span>

  <!--
    The mobile panel is a sibling of the bar rather than a child of the desktop
    list, so the two navigations never fight over the same markup. It renders
    server-side and is simply hidden until opened — with JavaScript off, the
    links are still in the document for a screen reader and for search.
  -->
  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="container mobile-inner" aria-label="Menü">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                class="mobile-top"
                href={item.href}
                aria-current={groupActive(item) ? 'page' : undefined}
              >
                {item.label}
              </a>
              {'children' in item && (
                <ul class="mobile-children">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isActive(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li>
          <a
            class="mobile-top"
            href="/ara/"
            aria-haspopup="dialog"
            aria-controls="site-search-dialog"
            data-search-trigger>Ara</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<dialog
  class="search-dialog"
  id="site-search-dialog"
  aria-labelledby="site-search-title"
  data-search-dialog
>
  <div class="search-panel" data-search-panel>
    <div class="search-panel-head">
      <h2 id="site-search-title">Ara</h2>
      <button type="button" class="search-close" aria-label="Aramayı kapat" data-search-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"></path>
        </svg>
      </button>
    </div>

    <form class="dialog-search-form" data-dialog-search-form role="search">
      <label for="dialog-search-query" class="visually-hidden">Arama terimi</label>
      <input
        id="dialog-search-query"
        name="q"
        type="search"
        placeholder="şifre, 2FA, phishing…"
        autocomplete="off"
        autofocus
        data-dialog-search-input
      />
      <button type="submit" class="button">Ara</button>
    </form>

    <p class="search-hint" data-dialog-search-hint>En az iki karakter yazın.</p>
    <ul class="search-results" data-dialog-search-results></ul>
  </div>
</dialog>

<script>
  import { searchDocuments, type SearchDocument } from '../lib/search';

  /*
   * Two independent controls, no framework.
   *
   * Both close on Escape and on an outside click, and both keep
   * `aria-expanded` on the element that actually toggles them. Neither opens
   * on hover: a hover-only menu is unreachable by touch and by keyboard.
   */
  const setup = (): void => {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;

    // The rail expresses the unread portion of the document: nearly full at
    // the top, then contracting toward its left origin as reading progresses.
    // requestAnimationFrame keeps it coupled to the browser's paint cycle;
    // there is no easing delay or synthetic catch-up animation.
    let railFrame = 0;
    const updateRail = (): void => {
      railFrame = 0;
      const scrollRange = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
      const progress = Math.min(1, Math.max(0, window.scrollY / scrollRange));
      const remaining = Math.max(0.055, 1 - progress * 0.945);
      header.style.setProperty('--scroll-remaining', remaining.toFixed(4));
    };
    const requestRailUpdate = (): void => {
      if (railFrame) return;
      railFrame = window.requestAnimationFrame(updateRail);
    };

    updateRail();
    window.addEventListener('scroll', requestRailUpdate, { passive: true });
    window.addEventListener('resize', requestRailUpdate, { passive: true });

    // ── Desktop group ────────────────────────────────────────────────────
    const group = header.querySelector<HTMLElement>('[data-group]');
    const toggle = header.querySelector<HTMLButtonElement>('[data-group-toggle]');
    const menu = header.querySelector<HTMLElement>('[data-group-menu]');

    let closeTimer: number | undefined;
    let groupExplicitlyOpen = false;

    const setGroup = (open: boolean): void => {
      if (!toggle || !menu || !group) return;
      window.clearTimeout(closeTimer);
      if (!open) groupExplicitlyOpen = false;
      toggle.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      group.classList.toggle('is-open', open);
    };

    toggle?.addEventListener('click', () => {
      if (groupExplicitlyOpen) {
        setGroup(false);
        return;
      }
      groupExplicitlyOpen = true;
      setGroup(true);
    });

    /*
     * Hover and focus OPEN the group; they never own it.
     *
     * The click and keyboard paths above are unchanged, so a touch device — or
     * anyone using a keyboard — gets the same menu without a pointer. Hover is
     * added on top for the pointing device that can use it, which is what
     * `(hover: hover) and (pointer: fine)` tests for: a phone that reports a
     * synthetic hover must not open a menu the user never asked for.
     *
     * Closing is delayed. The gap between the label and the panel is real
     * space a pointer has to cross, and a menu that vanishes mid-crossing is
     * worse than one that never opened.
     */
    const CLOSE_DELAY = 200;
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');

    const openOnIntent = (): void => {
      if (!canHover.matches) return;
      setGroup(true);
    };

    const closeSoon = (): void => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setGroup(false), CLOSE_DELAY);
    };

    group?.addEventListener('pointerenter', openOnIntent);
    group?.addEventListener('pointerleave', closeSoon);

    // Focus entering the group opens it; focus leaving the group closes it,
    // which is what makes tabbing through the menu behave like hovering it.
    group?.addEventListener('focusin', (event) => {
      // The toggle owns its click/Enter state. Opening it during the focus
      // event would make that same click immediately toggle it closed again.
      if (event.target === toggle) return;
      setGroup(true);
    });
    group?.addEventListener('focusout', (event) => {
      const next = (event as FocusEvent).relatedTarget as Node | null;
      if (next && group.contains(next)) return;
      setGroup(false);
    });

    // ── Mobile panel ─────────────────────────────────────────────────────
    const button = header.querySelector<HTMLButtonElement>('[data-menu-button]');
    const panel = header.querySelector<HTMLElement>('[data-mobile-nav]');

    const setPanel = (open: boolean): void => {
      if (!button || !panel) return;
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      header.classList.toggle('menu-open', open);
    };

    button?.addEventListener('click', () => {
      setPanel(button.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      // Return focus to whichever control was open, or the user is stranded.
      if (toggle?.getAttribute('aria-expanded') === 'true') {
        setGroup(false);
        toggle.focus();
      }
      if (button?.getAttribute('aria-expanded') === 'true') {
        setPanel(false);
        button.focus();
      }
    });

    document.addEventListener('click', (event) => {
      const target = event.target as Node;
      if (group && !group.contains(target)) setGroup(false);
      if (panel && button && !panel.contains(target) && !button.contains(target)) setPanel(false);
    });

    // A resize past the breakpoint must not leave a hidden panel "open".
    window.matchMedia('(min-width: 61rem)').addEventListener('change', () => {
      setPanel(false);
      setGroup(false);
    });

    // Losing hover capability mid-session (a tablet docking, a stylus) must
    // not strand an open menu that nothing will now close.
    canHover.addEventListener('change', () => setGroup(false));

    // ── Search dialog ────────────────────────────────────────────────────
    // The hrefs remain real /ara/ links, so search still works without JS.
    const searchDialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const searchPanel = searchDialog?.querySelector<HTMLElement>('[data-search-panel]');
    const searchClose = searchDialog?.querySelector<HTMLButtonElement>('[data-search-close]');
    const searchForm = searchDialog?.querySelector<HTMLFormElement>('[data-dialog-search-form]');
    const searchInput = searchDialog?.querySelector<HTMLInputElement>('[data-dialog-search-input]');
    const searchHint = searchDialog?.querySelector<HTMLElement>('[data-dialog-search-hint]');
    const searchResults = searchDialog?.querySelector<HTMLUListElement>(
      '[data-dialog-search-results]',
    );
    const searchTriggers = document.querySelectorAll<HTMLAnchorElement>('[data-search-trigger]');

    if (
      searchDialog &&
      searchPanel &&
      searchClose &&
      searchForm &&
      searchInput &&
      searchHint &&
      searchResults
    ) {
      let returnFocus: HTMLElement | null = null;
      let documents: SearchDocument[] | null = null;
      let loading: Promise<SearchDocument[]> | null = null;
      let searchTimer: number | undefined;

      const loadIndex = (): Promise<SearchDocument[]> => {
        if (documents) return Promise.resolve(documents);
        if (!loading) {
          loading = fetch('/search-index.json')
            .then((response) => {
              if (!response.ok) throw new Error(`http ${response.status}`);
              return response.json() as Promise<SearchDocument[]>;
            })
            .then((data) => {
              documents = data;
              return data;
            });
        }
        return loading;
      };

      const escapeText = (value: string): string => {
        const element = document.createElement('div');
        element.textContent = value;
        return element.innerHTML;
      };

      const runSearch = async (): Promise<void> => {
        const query = searchInput.value.trim();
        if (query.length < 2) {
          searchResults.innerHTML = '';
          searchHint.textContent = 'En az iki karakter yazın.';
          return;
        }

        let docs: SearchDocument[];
        try {
          docs = await loadIndex();
        } catch {
          searchHint.textContent = 'Arama dizini yüklenemedi. Sayfayı yenileyip tekrar deneyin.';
          return;
        }

        const hits = searchDocuments(docs, query);
        searchHint.textContent = hits.length
          ? `${hits.length} sonuç bulundu.`
          : 'Sonuç bulunamadı. Farklı bir kelime deneyin.';
        searchResults.innerHTML = hits
          .map(
            (hit) => `<li class="search-result">
<a href="${escapeText(hit.url)}">
<span class="search-result-kind">${escapeText(hit.kindLabel)}</span>
<span class="search-result-title">${escapeText(hit.title)}</span>
<span class="search-result-desc">${escapeText(hit.description)}</span>
<span class="search-result-cat">${escapeText(hit.categoryName)}</span>
</a></li>`,
          )
          .join('');
      };

      const restoreAfterSearch = (): void => {
        document.documentElement.classList.remove('search-open');
        returnFocus?.focus();
        returnFocus = null;
      };

      const closeSearch = (): void => {
        if (searchDialog.open) searchDialog.close();
        restoreAfterSearch();
      };

      searchTriggers.forEach((trigger) => {
        trigger.addEventListener('click', (event) => {
          event.preventDefault();
          returnFocus = trigger;
          setPanel(false);
          setGroup(false);
          document.documentElement.classList.add('search-open');
          searchDialog.showModal();
          window.requestAnimationFrame(() => searchInput.focus());
        });
      });

      searchClose.addEventListener('click', closeSearch);
      searchDialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeSearch();
      });
      searchDialog.addEventListener('click', (event) => {
        if (event.target === searchDialog) closeSearch();
      });
      searchDialog.addEventListener('close', restoreAfterSearch);

      searchInput.addEventListener('input', () => {
        window.clearTimeout(searchTimer);
        searchTimer = window.setTimeout(() => void runSearch(), 180);
      });
      searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        void runSearch();
      });
    }
  };

  setup();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--surface-0) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .scroll-rail {
    position: absolute;
    inset: auto 1rem -2px;
    height: 3px;
    pointer-events: none;
    overflow: hidden;
  }

  .scroll-rail-line {
    position: absolute;
    inset: 1px 0 auto;
    height: 1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--interaction-confirm) 28%, var(--border-strong)),
      color-mix(in srgb, var(--interaction-accent) 18%, var(--border-strong))
    );
    transform: scaleX(var(--scroll-remaining, 1));
    transform-origin: left;
    will-change: transform;
  }

  .scroll-rail-node {
    position: absolute;
    top: 0;
    left: calc((100% - var(--trace-node-size)) * var(--scroll-remaining, 1));
    width: var(--trace-node-size);
    height: var(--trace-node-size);
    background: color-mix(in srgb, var(--interaction-accent) 18%, var(--border-strong));
    transform: translateX(-50%);
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-height: 62px;
  }

  .logo-link {
    text-decoration: none;
    margin-right: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .desktop-nav {
    padding-left: var(--sp-5);
    border-left: 1px solid var(--border);
  }

  .nav a {
    position: relative;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.55rem 0;
    display: inline-block;
    white-space: nowrap;
  }

  .nav > li > a::after,
  .group-link::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: var(--interaction-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .nav a[aria-current='page'] {
    color: var(--text);
  }

  .nav > li > a[aria-current='page']::after,
  .group-link[aria-current='page']::after {
    background: var(--interaction-confirm);
    transform: scaleX(1);
  }

  /* --- grouped item --- */

  .nav-group {
    position: relative;
  }

  .group-head {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
  }

  .group-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* Comfortably clickable without widening the bar. */
    width: 26px;
    height: 32px;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text-muted);
    cursor: pointer;
  }

  .group-toggle svg {
    transition: transform var(--trace-duration) var(--trace-ease);
  }

  .nav-group.is-open .group-toggle svg {
    transform: rotate(180deg);
  }

  /*
   * The panel is offset from the label, but the group's own hover area is
   * extended upward by the pseudo-element below so the pointer never crosses
   * an inert gap on the way down.
   */
  .group-menu::before {
    content: '';
    position: absolute;
    inset: -0.6rem 0 auto 0;
    height: 0.6rem;
  }

  .group-menu {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: -0.75rem;
    z-index: 30;
    width: 20rem;
    max-width: calc(100vw - 2rem);
    list-style: none;
    margin: 0;
    padding: var(--sp-2);
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 40px rgb(0 0 0 / 45%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav > li > a::after,
    .group-link::after {
      transition: transform var(--trace-duration) var(--trace-ease);
    }

    .group-menu {
      animation: group-in var(--surface-duration) var(--trace-ease);
    }

    @keyframes group-in {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }
    }
  }

  .group-menu a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--sp-3);
    border-radius: var(--radius);
    border-bottom: 0;
    white-space: normal;
  }

  .group-menu a::after {
    content: '';
    position: absolute;
    left: var(--sp-3);
    bottom: 0.34rem;
    width: 2.75rem;
    height: var(--trace-thickness);
    background: var(--interaction-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  .group-menu a:focus-visible {
    background: var(--surface-2);
  }

  .group-menu-label {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
  }

  .group-menu-blurb {
    font-family: var(--font-body);
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .search-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    min-height: 44px;
    padding-inline: var(--sp-2);
  }

  .search-link {
    position: relative;
  }

  .search-link::after {
    content: '';
    position: absolute;
    inset: auto var(--sp-2) 5px;
    height: var(--trace-thickness);
    background: var(--interaction-accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  :global(html.search-open) {
    overflow: hidden;
  }

  .search-dialog {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: clamp(4.5rem, 12vh, 8rem) var(--sp-4) var(--sp-6);
    color: var(--text);
    background: transparent;
    border: 0;
    overflow-y: auto;
  }

  .search-dialog::backdrop {
    background: rgb(3 7 8 / 78%);
    backdrop-filter: blur(3px);
  }

  .search-panel {
    width: min(42rem, 100%);
    max-height: calc(100vh - clamp(6rem, 18vh, 11rem));
    margin-inline: auto;
    padding: var(--sp-5);
    background: var(--surface-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgb(0 0 0 / 55%);
    overflow-y: auto;
  }

  .search-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .search-panel-head h2 {
    margin: 0;
    font-size: var(--step-2);
  }

  .search-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

