# TurkCyber — environment variable NAMES only. Never commit real values.
# Local development: copy the relevant entries into `.dev.vars` (gitignored).
# Deployed environments: set with `wrangler secret put <NAME>`.

# --- /boss authentication ---
# Owner username for the private console.
BOSS_USER=
# PBKDF2-SHA256 hash, format: pbkdf2$<iterations>$<base64 salt>$<base64 derivedBits>
# Iterations MUST be exactly 100000 (Workers runtime ceiling). Generate with:
#   node scripts/hash-password.mjs
BOSS_PASSWORD_HASH=
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# --- Cloudflare Turnstile (comment spam protection) ---
# Site key is public and may appear in client HTML.
PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is server-side only. Never expose.
TURNSTILE_SECRET_KEY=

# --- Comment abuse keying ---
# Secret used to HMAC visitor IPs into non-reversible abuse keys for comments.
COMMENT_IP_PEPPER=
